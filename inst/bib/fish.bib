@Article{fishes:Lindseth:2018:USM,
  author =       "Adelaide V. Lindseth and Phillip S. Lobel",
  title =        "Underwater Soundscape Monitoring and Fish Bioacoustics: a Review",
  journal =      j-FISHES,
  volume =       "3",
  number =       "3",
